#include "Shared.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = dev.lucascaro.ShieldStat
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// No Dock icon, no app menu: this is a menu bar accessory.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES

CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES

// Deliberately NOT set yet:
//   CODE_SIGN_ENTITLEMENTS = Config/ShieldStat.entitlements
// com.apple.developer.usernotifications.time-sensitive is a restricted
// entitlement. With ad-hoc signing the kernel SIGKILLs the app at launch —
// verified: identical bundle exits 137 with the entitlement and runs without
// it. Re-enable this line together with Developer ID signing and a
// provisioning profile that carries the entitlement.
COMBINE_HIDPI_IMAGES = YES
