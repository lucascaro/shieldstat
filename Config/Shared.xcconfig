// Project-wide build settings. Kept in a file rather than clicked into the GUI
// so the project stays cheap to regenerate with XcodeGen later.

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_OBJC_WEAK = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
SWIFT_STRICT_CONCURRENCY = complete
